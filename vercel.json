{
    "version": 2,
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": "/api/server.js"
      }
    ],
    "functions": {
      "api/server.js": {
        "runtime": "@vercel/node@2.0.0"
      }
    },
    "build": {
      "env": {
        "NPM_COMMAND": "npm install"
      }
    }
  }
  